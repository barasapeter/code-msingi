# Defaults work out of the box. Set this to use another SQLite file or database.
DATABASE_URL=sqlite:///./ebooks.db
SESSION_SECRET=replace-with-a-long-random-secret-before-deploying

# Safaricom Daraja STK Push (C2B)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS endpoint reachable by Safaricom, including this app's callback route.
MPESA_CALLBACK_URL=https://your-public-domain.example/payments/mpesa/callback

# Google-only administrator sign-in. Register this exact callback URL in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: needed when running behind a reverse proxy or on a public domain.
# GOOGLE_OAUTH_REDIRECT_URL=https://your-domain.example/admin/auth/google/callback
MASTER_ADMIN_EMAIL=
